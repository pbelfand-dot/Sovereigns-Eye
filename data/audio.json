{
  "_comment": "Sound for Sovereign's Eye (CC0 library in audio/, see audio/README.md). Four buses: Music, Ambience, SFX, UI. 'volume_db' is each bus's mix level; the player's sliders scale on top of it. Families are numbered file groups picked at random with slight pitch variation; events name what the game plays (button clicks, coins, a recruit accepting...).",

  "buses": {
    "Music": { "volume_db": -9.0 },
    "Ambience": { "volume_db": -8.0 },
    "SFX": { "volume_db": -5.0 },
    "UI": { "volume_db": -10.0 }
  },

  "music": {
    "root": "res://audio/music/randommind-medieval/",
    "fade": 2.5,
    "gap": [6.0, 16.0],
    "_contexts": "Which tracks play where. A context with one track loops it; with several, tracks play in random order with a short silence between them.",
    "contexts": {
      "menu": ["old_tower_inn_loop"],
      "day": ["bards_tale_loop", "harvest_season", "market_day_loop"],
      "night": ["old_tower_inn_loop"],
      "court": ["kings_feast_loop"],
      "festival": ["minstrel_dance_loop"],
      "exploration": ["exploration"],
      "battle": ["battle"],
      "victory": ["victory"],
      "defeat": ["defeat"]
    },
    "day_hours": [6.0, 20.0]
  },

  "ambience": {
    "root": "res://audio/ambience/freesound-cc0/",
    "_zones": "Beds fade in around their place (the square, or every building of a type) as the camera's focus nears it, and fade out as the camera zooms away. 'hours' limits a zone to the working day; 'day_only' beds fade at dusk.",
    "zones": {
      "village": { "layers": { "village_morning": 0.85 }, "everywhere": true, "day_only": true },
      "market": { "layers": { "market_busy_crowd": 0.8 }, "at": "square", "radius": 32.0, "hours": [7.0, 19.0] },
      "tavern": { "layers": { "tavern_chatter": 0.75, "fireplace_loop": 0.55 }, "building_types": ["tavern"], "radius": 18.0 },
      "smithy": { "layers": { "blacksmith_work": 0.8 }, "building_types": ["smithy"], "radius": 18.0, "hours": [7.0, 18.0] }
    },
    "zoom_full": 40.0,
    "zoom_silent": 170.0,
    "fade_speed": 1.2
  },

